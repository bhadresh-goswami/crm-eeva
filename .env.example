# SMTP settings (copy this file to .env and provide real credentials)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_AUTH=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Support Team"
MAIL_TIMEOUT=5
MAIL_DEBUG=false

APP_ENV=production

# Database settings. DB_HOST defaults to 127.0.0.1 and DB_PORT to 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
