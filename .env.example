# SMTP settings (never commit real credentials)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_AUTH=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Support Team
MAIL_TIMEOUT=5
MAIL_DEBUG=false

# Runtime environment; the SMTP test route is available only in development.
APP_ENV=production
